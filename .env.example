# ---------------------------------------------------------------------------
# Ximverse — environment variables
#
# Local:  copy this file to .env.local (gitignored). Every value is optional;
#         with none set, the app runs at http://localhost:3000.
# Vercel: set these under Project → Settings → Environment Variables, scoped to
#         Production / Preview as needed. NEXT_PUBLIC_* values are baked in at
#         build time, so redeploy after changing one.
# ---------------------------------------------------------------------------

# Public origin of the site, no trailing slash. Used for absolute URLs in
# metadata (canonical links, social previews).
#   Production: https://ximverse.ai
#   Preview:    leave unset — falls back to the Vercel deployment URL
#   Local:      leave unset — falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Base URL for backend API calls. Unset means same-origin "/api".
# Set it only if the backend runs as a separate service, e.g.
#   https://api.ximverse.ai
NEXT_PUBLIC_API_BASE_URL=
